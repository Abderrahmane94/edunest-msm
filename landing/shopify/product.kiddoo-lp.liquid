/* ── Page ─────────────────────────────────────────────────────────────────── */
var $ = function (s) { return document.querySelector(s); };
var params = new URLSearchParams(location.search);
function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
var lang = params.get('lang') === 'ar' || params.get('lang') === 'fr' ? params.get('lang') : (lsGet('kd-lang') || 'fr');
var screen = 0;
function T() { return COPY[lang]; }
function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
function fmt(n) { return new Intl.NumberFormat('fr-FR').format(n).replace(/ | /g, ' '); }
// In Arabic the amount stays in reading order: a left-to-right isolate around the number.
function money(n) { return lang === 'ar' ? '⁦' + fmt(n) + '⁩ دج' : fmt(n) + ' DA'; }
function wa(text) { return 'https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(text); }
function fill(s, o) { return s.replace(/\{(\w+)\}/g, function (_, k) { return o[k] == null ? '' : o[k]; }); }
function plan() { var v = (document.querySelector('input[name=plan]:checked') || {}).value || 'standard'; return PLANS.filter(function (p) { return p.id === v; })[0]; }
function cycle() { return (document.querySelector('input[name=cycle]:checked') || {}).value || 'monthly'; }
function amount() { var p = plan(); return p.monthly == null ? null : (cycle() === 'annual' ? p.monthly * 10 : p.monthly); }
function list(sel, items) { $(sel).innerHTML = items.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join(''); }

function renderPlans() {
  var D = T(), c = cycle(), cur = plan().id, box = $('#plans');
  box.querySelectorAll('.plan').forEach(function (n) { n.remove(); });
  PLANS.forEach(function (p, i) {
    var price = p.monthly == null ? D['plan.quote'] : money(c === 'annual' ? p.monthly * 10 : p.monthly);
    var per = p.monthly == null ? '' : '<small>' + esc(c === 'annual' ? D['per.year'] : D['per.month']) + '</small>';
    var el = document.createElement('label'); el.className = 'plan';
    el.innerHTML = '<input type="radio" name="plan" value="' + p.id + '"' + (p.id === cur ? ' checked' : '') + '>' + (p.rec ? '<span class="rec">' + esc(D['plan.rec']) + '</span>' : '') +
      '<span class="dot" aria-hidden="true"></span><span><span class="nm">' + esc(D.plans[i][0]) + '</span><span class="for">' + esc(D.plans[i][1]) + '</span></span><span class="pr">' + esc(price) + per + '</span>';
    box.appendChild(el);
  });
  renderTotal();
}
function renderTotal() {
  var D = T(), a = amount();
  $('#total').textContent = a == null ? D['plan.quote'] : money(a);
  $('#cycle').hidden = plan().monthly == null;
  $('#submit').firstElementChild.textContent = D['form.submit'];
}
function renderScreen() {
  var D = T();
