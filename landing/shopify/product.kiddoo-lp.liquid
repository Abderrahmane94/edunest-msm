  ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid'].forEach(function (k) { if (params.get(k)) utm[k] = params.get(k).slice(0, 200); });
  var body = {
    plan: p.id, cycle: c,
    directorName: $('#f-name').value.trim(), nurseryName: $('#f-nursery').value.trim(),
    phone: $('#f-phone').value.trim(), wilaya: $('#f-wilaya').value,
    language: lang, source: 'shopify', website: $('#f-website').value,
    tracking: { eventId: eventId, fbp: cookie('_fbp'), fbc: fbc(), pageUrl: location.href.split('#')[0].slice(0, 500), utm: utm },
  };
  fetch(API_URL + '/orders/public', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.success) throw new Error('send'); return j.data || {}; }); })
    .then(function (data) {
      // The browser's Lead with the platform's event id: Meta keeps one of the two.
      kdTrack('Lead', { content_name: p.id, currency: 'DZD', value: amount() || 0 }, { eventID: eventId });
      showDone(data.number || '', body.nurseryName);
    })
    .catch(function () { showError(); })
    .then(function () { btn.disabled = false; renderTotal(); });
});
function showDone(num, nursery) {
  var D = T();
  $('#done-ref').textContent = num ? fill(D['done.ref'], { num: num }) : ''; $('#done-ref').hidden = !num;
  $('#done-next').innerHTML = D['done.next'].map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('');
  $('#done-wa').href = wa(fill(D['wa.after'], { num: num, nursery: nursery }));
  $('#form').hidden = true; $('#done').hidden = false;
  $('#commande').scrollIntoView({ behavior: 'smooth', block: 'start' }); $('#done').focus({ preventScroll: true });
}
function showError() {
  var D = T(); $('#form-error').innerHTML = esc(D['err.send']) + ' <a href="' + wa(D['wa.ask']) + '" target="_blank" rel="noopener" dir="ltr">' + esc(WHATSAPP_DISPLAY) + '</a>'; $('#form-error').hidden = false;
}

// Mobile order bar: shown once the order card is out of view.
if ('IntersectionObserver' in window) {
  new IntersectionObserver(function (en) { $('#mbar').classList.toggle('on', !en[0].isIntersecting && window.scrollY > 300); }).observe($('#commande'));
}
apply();
</script>
</body>
</html>
