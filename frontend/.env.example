# ─── Frontend environment variables ──────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All VITE_* variables are exposed to the browser — never put secrets here.

# ─── API / real-time ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# ─── Firebase web push (from Firebase console → Project settings → web app) ───
# Public web-app identifiers — safe in the browser. Leave blank to disable push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# "Web Push certificates" key pair in FCM settings (Cloud Messaging tab)
VITE_FIREBASE_VAPID_KEY=
