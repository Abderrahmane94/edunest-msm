# ─── Backend environment variables ───────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://edunest:edunest_secret@localhost:5432/edunest?schema=public"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
# Frontend origin(s) — used for CORS and password-reset links.
# Comma-separate multiple origins if needed.
FRONTEND_URL="http://localhost:5173"
# Public app URL used when building payment checkout links.
APP_URL="http://localhost:5173"

# ─── JWT secrets ──────────────────────────────────────────────────────────────
# Use long, random values in production.
JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Leave blank in development — emails are logged to the console instead of sent.
RESEND_API_KEY=""

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Leave blank in development — SMS are logged to the console instead of sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── File uploads (Cloudinary) ────────────────────────────────────────────────
# Only used in production; uploads are mocked in development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Payments (Chargily) ──────────────────────────────────────────────────────
# Only used in production; checkout is mocked in development.
CHARGILY_API_KEY=""
CHARGILY_SECRET_KEY=""

# ─── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Paste the full service account JSON as a single line (SECRET — do not commit).
# Leave blank in development — push notifications are logged instead of sent.
FIREBASE_SERVICE_ACCOUNT=
