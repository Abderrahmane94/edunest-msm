  var m = D.mods[screen]; $('#screen').src = IMG[m[0] + '-' + lang]; $('#screen').alt = 'Kiddoo · ' + m[1];
}

function apply() {
  var D = T();
  document.documentElement.lang = lang; document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
  document.querySelectorAll('[data-i]').forEach(function (el) { var v = D[el.dataset.i]; if (v == null) return; if (el.hasAttribute('data-html')) el.innerHTML = v; else el.textContent = v; });
  document.querySelectorAll('[data-alt]').forEach(function (el) { el.alt = D[el.dataset.alt] || ''; });
  $('#lang').textContent = D['lang.switch'];
  list('#ticks', D.ticks); list('#before', D.before); list('#after', D.after); list('#parents-list', D.parentsList); list('#chips', D.chips);
  $('#proof').innerHTML = D.proof.map(function (p) { return '<div><b>' + esc(p[0]) + '</b>' + esc(p[1]) + '</div>'; }).join('');
  $('#adam-points').innerHTML = D.adamPoints.map(function (p) { return '<div><b>' + esc(p[0]) + '</b>' + esc(p[1]) + '</div>'; }).join('');
  $('#reassure').innerHTML = D.reassure.map(function (x) { return '<span>' + esc(x) + '</span>'; }).join('');
  $('#day').innerHTML = D.day.map(function (d) { return '<article class="moment"><div class="ph"><img src="' + IMG['jour-' + d[1]] + '" alt="" loading="lazy"><span class="time">' + d[0] + '</span></div><div class="bd"><h3>' + esc(d[2]) + '</h3><p>' + esc(d[3]) + '</p><span class="rec">✓ ' + esc(d[4]) + '</span></div></article>'; }).join('');
  $('#tabs').innerHTML = D.mods.map(function (m, i) { return '<button class="tab" type="button" role="tab" data-k="' + i + '"><h3>' + esc(m[1]) + '</h3><p>' + esc(m[2]) + '</p></button>'; }).join('');
  $('#steps').innerHTML = D.steps.map(function (s) { return '<li class="card"><h3>' + esc(s[0]) + '</h3><p>' + esc(s[1]) + '</p></li>'; }).join('');
  $('#faqs').innerHTML = D.faqs.map(function (f, i) { return '<details' + (i === 0 ? ' open' : '') + '><summary>' + esc(f[0]) + '</summary><p>' + esc(f[1]) + '</p></details>'; }).join('');
