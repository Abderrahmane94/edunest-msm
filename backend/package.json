    "cloudinary": "^2.5.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^14.3.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "3.23.8"
