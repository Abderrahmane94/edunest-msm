$('#lang').addEventListener('click', function () { lang = lang === 'fr' ? 'ar' : 'fr'; lsSet('kd-lang', lang); apply(); });
$('#form').addEventListener('change', function (e) { if (e.target.name === 'cycle') renderPlans(); if (e.target.name === 'plan') renderTotal(); });
$('#tabs').addEventListener('click', function (e) { var b = e.target.closest('.tab'); if (!b) return; screen = +b.dataset.k; renderScreen(); });
$('#tabs').addEventListener('keydown', function (e) {
  var n = T().mods.length, d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key]; if (!d) return;
  e.preventDefault(); screen = (screen + d + n) % n; renderScreen(); $('#tabs').children[screen].focus();
});

