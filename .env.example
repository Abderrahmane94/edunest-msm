# =============================================================================
# EduNest — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Do NOT commit .env files to version control.
# =============================================================================

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=edunest
POSTGRES_PASSWORD=edunest_secret
POSTGRES_DB=edunest
POSTGRES_PORT=5432

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://edunest:edunest_secret@localhost:5432/edunest?schema=public

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production

# ─── Chargily Pay (Algerian payment gateway) ─────────────────────────────────
# Get keys from: https://pay.chargily.com
CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=

# ─── Cloudinary (file storage) ───────────────────────────────────────────────
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (email service) ──────────────────────────────────────────────────
# Get API key from: https://resend.com
RESEND_API_KEY=

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+213xxxxxxxxx

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
# Paste the full service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT=

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
