{%- comment -%}
  Kiddoo order landing: a page of its own (no theme header, footer or styles), in French and Arabic.
  Its form puts the chosen plan in the cart with the nursery's details (line item properties, cart
  attributes and note), then opens Shopify's checkout: the order lands in Orders, with no shipping
  (the plans are not physical). Images are in Settings > Files; the variants are found by their SKU.
{%- endcomment -%}
{%- layout none -%}
<!doctype html>
<html lang="fr" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kiddoo · Logiciel de gestion de crèche</title>
<meta name="description" content="Kiddoo réunit la direction, les éducatrices et les parents : présence, rapport du jour, messages, frais et équipe, en arabe et en français. Démo gratuite le jour même.">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="Kiddoo · Toute votre crèche, dans une seule application">
<meta property="og:image" content="https:{{ 'kiddoo-hero-classe.jpg' | file_img_url: '1200x' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap">
{{ content_for_header }}
<script>
// Meta Pixel (Kiddoo). PageView and ViewContent here; InitiateCheckout when the form is started; Lead when the order is saved,
// with the same event id as the platform's Conversions API (Meta keeps one). Purchase: sent by the platform when the order is won.
// The store's apps load other pixels on this page: Kiddoo's events go to Kiddoo's pixel only (kdTrack).
var KD_PIXEL = '2354393235321830';
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init', KD_PIXEL);
// One event, to Kiddoo's pixel only (the Single variant of track).
function kdTrack(name, data, options) { if (window.fbq) fbq(['track', 'Single'].join(''), KD_PIXEL, name, data || {}, options || {}); }
kdTrack('PageView');
kdTrack('ViewContent', { content_ids: ['{{ product.id }}'], content_type: 'product', content_name: 'Kiddoo', currency: 'DZD', value: 8900 });
</script>
<style>
:root {
  --ink: #111018; --text: #34323D; --muted: #6A6775; --line: #E7E3DD; --band: #F6F4F0; --cream: #FEF4EC;
  --indigo: #4F49CF; --indigo-d: #3D37B0; --green: #13855F; --orange: #C25A12; --red: #CF2A50;
  --indigo-soft: #ECEBFB; --green-soft: #E2F3EC; --orange-soft: #FBEDE2; --red-soft: #FBE6EB;
  --shadow: 0 1px 2px rgba(17,16,24,.06), 0 22px 44px -22px rgba(17,16,24,.30);
  --shadow-lg: 0 2px 4px rgba(17,16,24,.06), 0 40px 80px -36px rgba(30,26,90,.45);
  --f-display: "Manrope", "IBM Plex Sans Arabic", system-ui, sans-serif;
  --f-body: "IBM Plex Sans", "IBM Plex Sans Arabic", "Segoe UI", system-ui, sans-serif;
  --ls: -0.03em; --r: 20px; color-scheme: light;
}
:root[lang="ar"] { --f-display: "IBM Plex Sans Arabic", system-ui, sans-serif; --f-body: "IBM Plex Sans Arabic", system-ui, sans-serif; --ls: 0; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body { margin: 0; background: #fff; color: var(--text); font: 16px/1.65 var(--f-body); -webkit-font-smoothing: antialiased; overflow-x: clip; }
h1, h2, h3 { font-family: var(--f-display); color: var(--ink); letter-spacing: var(--ls); margin: 0; text-wrap: balance; }
p { margin: 0; } img { max-width: 100%; display: block; } a { color: inherit; }
:focus-visible { outline: 3px solid var(--indigo); outline-offset: 3px; border-radius: 6px; }
.wrap { max-width: 1180px; margin-inline: auto; padding-inline: max(20px, env(safe-area-inset-left, 0px)); }
section { padding-block: clamp(64px, 8vw, 108px); scroll-margin-top: 70px; }
.stripe { display: flex; gap: 4px; width: 72px; height: 4px; }
.stripe i { flex: 1; border-radius: 4px; } .stripe i:nth-child(1) { background: var(--indigo); } .stripe i:nth-child(2) { background: var(--green); } .stripe i:nth-child(3) { background: var(--orange); } .stripe i:nth-child(4) { background: var(--red); }
.head { max-width: 720px; margin: 0 auto clamp(36px, 5vw, 56px); text-align: center; }
.head .stripe { margin: 0 auto 18px; }
.eyebrow { font-size: 13px; font-weight: 700; color: var(--indigo); letter-spacing: .06em; text-transform: uppercase; margin-bottom: 10px; display: block; }
:root[lang="ar"] .eyebrow { letter-spacing: 0; }
.head h2 { font-size: clamp(30px, 3.8vw, 44px); line-height: 1.1; margin-bottom: 14px; }
.head p { color: var(--muted); font-size: 18px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; font: 600 16px/1 var(--f-body); text-decoration: none; padding: 16px 24px; border-radius: 14px; border: 1.5px solid transparent; cursor: pointer; transition: transform .2s, background .2s, box-shadow .2s; }
.btn:hover { transform: translateY(-1px); }
.btn-primary { background: var(--indigo); color: #fff; box-shadow: 0 12px 24px -12px rgba(79,73,207,.8); }
.btn-primary:hover { background: var(--indigo-d); }
.btn-light { background: #fff; color: var(--ink); border-color: var(--line); }
.btn-ghost { background: rgba(255,255,255,.12); color: #fff; border-color: rgba(255,255,255,.4); backdrop-filter: blur(6px); }
.btn svg { width: 18px; height: 18px; flex: none; }

/* Top bar */
.top { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; gap: 28px; height: 66px; }
.logo { display: inline-flex; direction: ltr; } .logo img { height: 28px; width: auto; }
.links { display: flex; gap: 24px; } .links a { text-decoration: none; color: var(--muted); font-weight: 500; font-size: 15px; } .links a:hover { color: var(--ink); }
.top-end { margin-inline-start: auto; display: flex; gap: 10px; align-items: center; }
.lang { background: #fff; border: 1.5px solid var(--line); color: var(--ink); font: 500 14px/1 var(--f-body); padding: 10px 14px; border-radius: 12px; cursor: pointer; }
.top .btn { padding: 12px 18px; font-size: 14px; }

/* Hero: a real classroom behind, the order card in front */
.hero { position: relative; padding-block: clamp(40px, 6vw, 80px) clamp(56px, 7vw, 96px); color: #fff; isolation: isolate; }
.hero-bg { position: absolute; inset: 0; z-index: -2; }
.hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; }
.hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(14,12,40,.92) 0%, rgba(14,12,40,.80) 42%, rgba(14,12,40,.35) 100%); }
:root[dir="rtl"] .hero::before { background: linear-gradient(260deg, rgba(14,12,40,.92) 0%, rgba(14,12,40,.80) 42%, rgba(14,12,40,.35) 100%); }
.hero-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(28px, 4vw, 64px); align-items: center; }
.pill { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25); backdrop-filter: blur(6px); }
.pill i { width: 8px; height: 8px; border-radius: 50%; background: #7FE0BC; box-shadow: 0 0 0 4px rgba(127,224,188,.25); }
.hero h1 { color: #fff; font-size: clamp(38px, 5vw, 62px); line-height: 1.03; font-weight: 800; margin: 20px 0 18px; }
:root[lang="ar"] .hero h1 { line-height: 1.28; font-weight: 700; }
.hero h1 em { font-style: normal; color: #B5B1FF; }
.hero .sub { font-size: 19px; color: rgba(255,255,255,.82); max-width: 560px; }
.hero .ticks { list-style: none; padding: 0; margin: 26px 0 30px; display: grid; gap: 12px; }
.hero .ticks li { display: flex; gap: 12px; align-items: center; font-weight: 500; }
.hero .ticks li::before { content: "✓"; flex: none; width: 26px; height: 26px; border-radius: 9px; display: grid; place-items: center; background: rgba(127,224,188,.18); color: #7FE0BC; font-weight: 700; font-size: 14px; }
.hero .cta { display: flex; flex-wrap: wrap; gap: 12px; }
.proof { display: flex; gap: 22px; margin-top: 34px; flex-wrap: wrap; }
.proof div { font-size: 14px; color: rgba(255,255,255,.7); }
.proof b { display: block; font: 800 26px/1.1 var(--f-display); color: #fff; }

/* Order card */
.order { background: #fff; color: var(--text); border-radius: 24px; box-shadow: var(--shadow-lg); padding: clamp(22px, 3vw, 32px); scroll-margin-top: 86px; position: relative; }
.order h2 { font-size: 25px; margin-bottom: 4px; }
.order .lead { color: var(--muted); font-size: 15px; margin-bottom: 18px; }
.plans { display: grid; gap: 10px; margin: 0 0 14px; border: 0; padding: 0; }
.plans legend, .field label { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 8px; padding: 0; }
.plan { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px solid var(--line); border-radius: 16px; cursor: pointer; transition: border-color .15s, background .15s; }
.plan input { position: absolute; opacity: 0; pointer-events: none; }
.plan .dot { flex: none; width: 20px; height: 20px; border-radius: 50%; border: 2px solid #CFCAD6; display: grid; place-items: center; }
.plan .dot::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--indigo); transform: scale(0); transition: transform .15s; }
.plan .nm { font-weight: 600; color: var(--ink); line-height: 1.25; display: block; }
.plan .for { font-size: 13px; color: var(--muted); }
.plan .pr { margin-inline-start: auto; text-align: end; font-weight: 700; color: var(--ink); white-space: nowrap; }
.plan .pr small { display: block; font-weight: 500; font-size: 12px; color: var(--muted); }
.plan .rec { position: absolute; top: -10px; inset-inline-end: 14px; font-size: 11px; font-weight: 700; background: var(--indigo); color: #fff; padding: 3px 9px; border-radius: 999px; }
.plan:has(input:checked) { border-color: var(--indigo); background: #FAFAFF; }
.plan:has(input:checked) .dot { border-color: var(--indigo); } .plan:has(input:checked) .dot::after { transform: scale(1); }
.plan:has(input:focus-visible) { outline: 3px solid var(--indigo); outline-offset: 2px; }
.cycle { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: var(--band); padding: 4px; border-radius: 14px; margin-bottom: 16px; }
.cycle[hidden] { display: none; }
.cycle label { text-align: center; padding: 10px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; color: var(--muted); position: relative; }
.cycle input { position: absolute; opacity: 0; }
.cycle label:has(input:checked) { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(17,16,24,.14); }
.cycle .save { display: block; font-size: 11px; color: var(--green); font-weight: 700; }
.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; position: relative; }
.field { display: flex; flex-direction: column; min-width: 0; } .field.full { grid-column: 1 / -1; }
.field input, .field select { font: 500 16px/1.2 var(--f-body); color: var(--ink); padding: 13px 14px; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; width: 100%; min-width: 0; }
.field input:focus, .field select:focus { outline: none; border-color: var(--indigo); box-shadow: 0 0 0 4px var(--indigo-soft); }
.field [aria-invalid="true"] { border-color: var(--red); }
.field .err { color: var(--red); font-size: 13px; margin-top: 4px; }
.field .err:empty { display: none; }
.hp { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.total { display: flex; justify-content: space-between; align-items: baseline; margin: 18px 0 12px; padding-top: 14px; border-top: 1px dashed var(--line); }
.total span { color: var(--muted); font-size: 14px; } .total b { font: 800 24px/1 var(--f-display); color: var(--ink); }
.order .submit { width: 100%; padding: 19px; font-size: 17px; }
.order .submit[disabled] { opacity: .75; cursor: progress; }
.done { text-align: center; padding: 8px 0; }
.done img { width: 140px; height: auto; margin: 0 auto 8px; border-radius: 50%; background: #FEF4EC; }
.done .ref { display: inline-block; margin: 6px 0 10px; padding: 4px 12px; border-radius: 999px; background: var(--green-soft, #E7F6EE); color: var(--green); font-weight: 700; }
.done .next { text-align: start; margin: 16px 0 20px; padding-inline-start: 20px; display: grid; gap: 8px; color: var(--muted); }
.done:focus { outline: none; }
.reassure { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-top: 12px; font-size: 13px; color: var(--muted); }
.reassure span::before { content: "✓ "; color: var(--green); font-weight: 700; }
.form-error { margin-top: 12px; padding: 12px 14px; border-radius: 12px; background: var(--red-soft); color: var(--red); font-size: 14px; }

/* Adam */
.adam { background: var(--cream); padding-block: 0; overflow: hidden; }
.adam-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(20px, 4vw, 56px); align-items: end; }
/* Adam's picture has the section's cream behind him: its sides and top fade out, so no edge shows. */
.adam-pic img, .tip img { height: auto; }
.adam-pic img { width: 100%; max-width: 440px; margin-inline: auto;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent), linear-gradient(to bottom, transparent, #000 12%);
  -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent), linear-gradient(to bottom, transparent, #000 12%); mask-composite: intersect; }
.tip img { -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%); mask-image: linear-gradient(to bottom, transparent, #000 14%); }
.adam-say { padding-block: clamp(48px, 6vw, 80px); }
.bubble { position: relative; background: #fff; border-radius: 26px; padding: clamp(24px, 3vw, 36px); box-shadow: var(--shadow); }
.bubble::before { content: ""; position: absolute; bottom: 34px; inset-inline-start: -14px; width: 28px; height: 28px; background: #fff; transform: rotate(45deg); border-radius: 4px; }
.bubble h2 { font-size: clamp(26px, 3.2vw, 36px); line-height: 1.15; margin-bottom: 12px; }
.bubble p { font-size: 17px; }
.bubble .sign { margin-top: 16px; font-weight: 700; color: var(--indigo); }
.adam-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
.adam-points div { background: rgba(255,255,255,.7); border: 1px solid #F3E3D5; border-radius: 16px; padding: 14px 16px; font-size: 14.5px; font-weight: 500; color: var(--ink); }
.adam-points b { display: block; font: 800 22px/1.1 var(--f-display); color: var(--indigo); margin-bottom: 2px; }

/* Before / after */
.ba { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.card { background: #fff; border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 28px; }
.tag { display: inline-block; font-size: 13px; font-weight: 700; padding: 6px 12px; border-radius: 999px; margin-bottom: 18px; }
.before .tag { background: var(--red-soft); color: var(--red); } .after .tag { background: var(--green-soft); color: var(--green); }
.after { border-color: #B9DCCD; background: linear-gradient(180deg, #F7FCFA, #fff 60%); }
.ba ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.ba li { display: flex; gap: 12px; align-items: flex-start; font-size: 16.5px; }
.ba li::before { flex: none; width: 26px; height: 26px; border-radius: 9px; display: grid; place-items: center; font-weight: 700; font-size: 14px; }
.before li::before { content: "×"; background: var(--red-soft); color: var(--red); } .after li::before { content: "✓"; background: var(--green-soft); color: var(--green); }

/* A day */
.band { background: var(--band); }
.day { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
.moment { background: #fff; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); display: flex; flex-direction: column; }
.moment .ph { aspect-ratio: 4 / 5; position: relative; overflow: hidden; }
.moment .ph img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
.moment:hover .ph img { transform: scale(1.04); }
.moment .time { position: absolute; top: 12px; inset-inline-start: 12px; background: rgba(255,255,255,.94); color: var(--ink); font: 800 14px/1 var(--f-display); padding: 8px 10px; border-radius: 10px; direction: ltr; }
.moment .bd { padding: 16px 16px 18px; border-top: 4px solid var(--c); flex: 1; }
.moment:nth-child(4n+1) { --c: var(--indigo); } .moment:nth-child(4n+2) { --c: var(--green); } .moment:nth-child(4n+3) { --c: var(--orange); } .moment:nth-child(4n+4) { --c: var(--red); }
.moment h3 { font-size: 17px; margin-bottom: 4px; } .moment p { font-size: 14px; }
.moment .rec { display: block; margin-top: 10px; font-size: 12.5px; font-weight: 600; color: var(--c); }

/* Modules: tabs with the real screen */
.mods { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
.tabs { display: grid; gap: 10px; }
.tab { text-align: start; background: #fff; border: 1.5px solid var(--line); border-radius: 16px; padding: 16px 18px; cursor: pointer; font: inherit; color: inherit; transition: border-color .15s, box-shadow .15s; }
.tab h3 { font-size: 17px; display: flex; gap: 10px; align-items: center; }
.tab h3::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--c, var(--indigo)); flex: none; }
.tab p { font-size: 14.5px; color: var(--muted); margin-top: 6px; display: none; padding-inline-start: 20px; }
.tab[aria-selected="true"] { border-color: var(--c, var(--indigo)); box-shadow: var(--shadow); } .tab[aria-selected="true"] p { display: block; }
.tab:nth-child(4n+1) { --c: var(--indigo); } .tab:nth-child(4n+2) { --c: var(--green); } .tab:nth-child(4n+3) { --c: var(--orange); } .tab:nth-child(4n+4) { --c: var(--red); }
.screen { background: linear-gradient(160deg, var(--indigo-soft), #fff); border-radius: 26px; padding: clamp(14px, 2vw, 24px); box-shadow: var(--shadow-lg); }
.screen img { border-radius: 14px; border: 1px solid var(--line); width: 100%; height: auto; background: #fff; }

/* Parents */
.duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
.duo .photo { position: relative; }
/* The father and his son are on the right of the photo. */
.duo .photo > img { border-radius: 26px; width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; object-position: 95% 50%; box-shadow: var(--shadow-lg); }
.notif { position: absolute; bottom: -22px; inset-inline-end: -10px; width: min(300px, 80%); background: #fff; border-radius: 18px; box-shadow: var(--shadow-lg); padding: 14px 16px; display: flex; gap: 12px; align-items: flex-start; }
.notif .ic { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--orange-soft); font-size: 20px; }
.notif b { display: block; color: var(--ink); font-size: 14px; } .notif span { font-size: 13px; color: var(--muted); }
.duo h2 { font-size: clamp(28px, 3.4vw, 40px); line-height: 1.12; margin-bottom: 14px; }
.duo .txt > p { font-size: 17px; color: var(--muted); }
.duo ul { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 12px; }
.duo li { display: flex; gap: 12px; align-items: center; font-weight: 500; color: var(--ink); }
.duo li::before { content: "✓"; flex: none; width: 26px; height: 26px; border-radius: 9px; display: grid; place-items: center; background: var(--green-soft); color: var(--green); font-weight: 700; font-size: 14px; }

/* Steps */
.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; list-style: none; margin: 0; padding: 0; counter-reset: s; }
.steps li { counter-increment: s; }
.steps li::before { content: counter(s); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; margin-bottom: 14px; font: 800 18px/1 var(--f-display); background: var(--indigo); color: #fff; }
.steps h3 { font-size: 18px; margin-bottom: 6px; } .steps p { font-size: 15px; }

/* Tip from Adam + included */
.tip { display: grid; grid-template-columns: 220px 1fr; gap: 0; align-items: end; background: var(--cream); border-radius: 28px; overflow: hidden; margin-top: clamp(36px, 5vw, 56px); }
.tip img { width: 100%; }
.tip .t { padding: 28px clamp(20px, 3vw, 36px) 30px; }
.tip h3 { font-size: 22px; margin-bottom: 8px; } .tip p { color: var(--text); }
.chips { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
.chips li { background: #fff; border: 1px solid #F0DECF; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 600; color: var(--ink); }

/* FAQ */
.faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
.faq-grid .head { text-align: start; margin: 0 0 22px; } .faq-grid .head .stripe { margin: 0 0 18px; }
.faq-grid .ph img { border-radius: 22px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
.faqs { border-top: 1px solid var(--line); }
.faqs details { border-bottom: 1px solid var(--line); }
.faqs summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 20px 2px; font: 600 17px/1.4 var(--f-body); color: var(--ink); }
.faqs summary::-webkit-details-marker { display: none; }
.faqs summary::after { content: "+"; font-size: 24px; line-height: 1; color: var(--indigo); transition: transform .2s; flex: none; }
.faqs details[open] summary::after { transform: rotate(45deg); }
.faqs details p { padding: 0 2px 20px; color: var(--muted); }

/* Final */
.final { position: relative; border-radius: 30px; overflow: hidden; color: #fff; padding: clamp(44px, 7vw, 84px) clamp(22px, 5vw, 64px); isolation: isolate; text-align: center; }
.final img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
.final::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(20,17,60,.72), rgba(20,17,60,.88)); }
.final h2 { color: #fff; font-size: clamp(28px, 3.8vw, 44px); margin-bottom: 12px; }
.final p { color: rgba(255,255,255,.82); font-size: 18px; }
.final .stripe { margin: 0 auto 20px; }
.final .cta { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
footer { padding: 34px 0 calc(34px + env(safe-area-inset-bottom, 0px)); color: var(--muted); font-size: 14px; text-align: center; }
footer .logo { justify-content: center; margin-bottom: 10px; } footer .logo img { height: 24px; }

/* Mobile order bar */
.mbar { display: none; }
@media (max-width: 1000px) {
  .links { display: none; }
  .hero-grid, .mods, .duo, .faq-grid { grid-template-columns: 1fr; }
  .hero { padding-bottom: 40px; }
  .day { grid-template-columns: repeat(3, 1fr); }
  .steps { grid-template-columns: 1fr 1fr; }
  .adam-grid { grid-template-columns: 1fr; }
  .adam-pic { order: 2; } .adam-pic img { max-width: 320px; }
  .adam-say { padding-bottom: 0; }
  .bubble::before { bottom: -12px; inset-inline-start: 50%; margin-inline-start: -14px; }
  .notif { inset-inline-end: 10px; }
  .mbar { display: flex; position: fixed; inset: auto 0 0 0; z-index: 50; gap: 12px; align-items: center; padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); background: #fff; border-top: 1px solid var(--line); box-shadow: 0 -12px 30px -18px rgba(17,16,24,.4); transform: translateY(110%); transition: transform .25s; }
  .mbar.on { transform: none; }
  .mbar .p { font-size: 13px; color: var(--muted); line-height: 1.2; } .mbar .p b { display: block; font: 800 18px/1.2 var(--f-display); color: var(--ink); }
  .mbar .btn { margin-inline-start: auto; padding: 14px 20px; }
  footer { padding-bottom: 100px; }
}
@media (max-width: 640px) {
  .top .btn { display: none; }
  .ba, .steps, .fields, .adam-points { grid-template-columns: 1fr; }
  .day { grid-template-columns: 1fr 1fr; } .day .moment:last-child { grid-column: 1 / -1; } .day .moment:last-child .ph { aspect-ratio: 16 / 10; }
  .tip { grid-template-columns: 120px 1fr; } .tip .t { padding: 20px 18px 22px; }
  .hero .sub { font-size: 17px; }
  .card { padding: 22px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="Kiddoo"><img src="{{ 'kiddoo-logo.png' | file_img_url: '400x' }}" alt="Kiddoo" width="140" height="31"></a>
    <nav class="links" aria-label="Sections">
      <a href="#journee" data-i="nav.day"></a><a href="#produit" data-i="nav.product"></a><a href="#faq" data-i="nav.faq"></a>
    </nav>
    <div class="top-end">
      <button class="lang" id="lang" type="button"></button>
      <a class="btn btn-primary" href="#commande" data-i="nav.cta"></a>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="hero-bg"><img src="{{ 'kiddoo-hero-classe.jpg' | file_img_url: '2000x' }}" alt="" fetchpriority="high" width="1672" height="941"></div>
    <div class="wrap hero-grid">
      <div>
        <span class="pill"><i></i><span data-i="hero.pill"></span></span>
        <h1 data-i="hero.title" data-html></h1>
        <p class="sub" data-i="hero.sub"></p>
        <ul class="ticks" id="ticks"></ul>
        <div class="cta">
          <a class="btn btn-primary" href="#commande" data-i="final.btn"></a>
          <a class="btn btn-ghost" href="#produit" data-i="hero.cta2"></a>
        </div>
        <div class="proof" id="proof"></div>
      </div>

      <div class="order" id="commande">
        <form id="form" novalidate>
          <h2 data-i="form.title"></h2>
          <p class="lead" data-i="form.lead"></p>
          <fieldset class="plans" id="plans"><legend data-i="form.plan"></legend></fieldset>
          <div class="cycle" id="cycle" role="radiogroup">
            <label><input type="radio" name="cycle" value="monthly" checked><span data-i="form.monthly"></span></label>
            <label><input type="radio" name="cycle" value="annual"><span data-i="form.annual"></span><span class="save" data-i="form.save"></span></label>
          </div>
          <div class="fields">
            <div class="field full"><label for="f-name" data-i="form.name"></label><input id="f-name" autocomplete="name" maxlength="80" required><span class="err" id="e-name" role="alert"></span></div>
            <div class="field full"><label for="f-nursery" data-i="form.nursery"></label><input id="f-nursery" autocomplete="organization" maxlength="100" required><span class="err" id="e-nursery" role="alert"></span></div>
            <div class="field full"><label for="f-phone" data-i="form.phone"></label><input id="f-phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" dir="ltr" placeholder="05 55 12 34 56" required><span class="err" id="e-phone" role="alert"></span></div>
            <div class="field full"><label for="f-wilaya" data-i="form.wilaya"></label><select id="f-wilaya" required></select><span class="err" id="e-wilaya" role="alert"></span></div>
            <div class="hp" aria-hidden="true"><label for="f-website">Website</label><input id="f-website" tabindex="-1" autocomplete="off"></div>
          </div>
          <div class="total"><span data-i="form.total"></span><b id="total"></b></div>
          <button class="btn btn-primary submit" type="submit" id="submit"><span data-i="form.submit"></span></button>
          <div class="reassure" id="reassure"></div>
          <div class="form-error" id="form-error" role="alert" hidden></div>
        </form>
        <div class="done" id="done" tabindex="-1" hidden>
          <img src="{{ 'kiddoo-adam-coucou.jpg' | file_img_url: '400x' }}" alt="" width="160" height="192">
          <h2 data-i="done.title"></h2>
          <p class="ref" id="done-ref" dir="ltr" hidden></p>
          <p data-i="done.text"></p>
          <ol class="next" id="done-next"></ol>
          <a class="btn btn-primary submit" id="done-wa" href="#" target="_blank" rel="noopener"><span data-i="done.wa"></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="adam">
    <div class="wrap adam-grid">
      <div class="adam-pic"><img src="{{ 'kiddoo-adam-coucou.jpg' | file_img_url: '900x' }}" alt="" loading="lazy" width="820" height="984" data-alt="adam.alt"></div>
      <div class="adam-say">
        <div class="bubble">
          <h2 data-i="adam.title"></h2>
          <p data-i="adam.text"></p>
          <p class="sign" data-i="adam.sign"></p>
        </div>
        <div class="adam-points" id="adam-points"></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head"><div class="stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div><h2 data-i="ba.title"></h2><p data-i="ba.sub"></p></div>
