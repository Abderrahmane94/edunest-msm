    setErr('#e-name', '#f-name', $('#f-name').value.trim().length >= 2 ? '' : D['err.name']),
    setErr('#e-nursery', '#f-nursery', $('#f-nursery').value.trim().length >= 2 ? '' : D['err.nursery']),
    setErr('#e-phone', '#f-phone', /^0[5-7]\d{8}$|^0[2-4]\d{7,8}$/.test(normPhone($('#f-phone').value)) ? '' : D['err.phone']),
    setErr('#e-wilaya', '#f-wilaya', $('#f-wilaya').value ? '' : D['err.wilaya']),
