        <div class="card after"><span class="tag" data-i="ba.after"></span><ul id="after"></ul></div>
      </div>
    </div>
  </section>

  <section class="band" id="journee">
    <div class="wrap">
      <div class="head"><span class="eyebrow" data-i="day.kicker"></span><h2 data-i="day.title"></h2><p data-i="day.sub"></p></div>
      <div class="day" id="day"></div>
    </div>
  </section>

  <section id="produit">
    <div class="wrap">
      <div class="head"><span class="eyebrow" data-i="mods.kicker"></span><h2 data-i="mods.title"></h2><p data-i="mods.sub"></p></div>
      <div class="mods">
        <div class="tabs" id="tabs" role="tablist"></div>
        <div class="screen"><img id="screen" alt="" width="1600" height="1000"></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap duo">
      <div class="photo">
        <img src="{{ 'kiddoo-hero-parent.jpg' | file_img_url: '1400x' }}" alt="" loading="lazy" data-alt="parents.alt">
        <div class="notif"><span class="ic" aria-hidden="true">☀️</span><div><b data-i="notif.title"></b><span data-i="notif.text"></span></div></div>
      </div>
      <div class="txt">
        <span class="eyebrow" data-i="parents.kicker"></span>
        <h2 data-i="parents.title"></h2>
        <p data-i="parents.text"></p>
        <ul id="parents-list"></ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head"><div class="stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div><h2 data-i="steps.title"></h2></div>
      <ol class="steps" id="steps"></ol>
      <div class="tip">
        <img src="{{ 'kiddoo-adam-idee.jpg' | file_img_url: '500x' }}" alt="" loading="lazy" width="820" height="984">
        <div class="t"><h3 data-i="tip.title"></h3><p data-i="tip.text"></p><ul class="chips" id="chips"></ul></div>
      </div>
    </div>
  </section>

  <section class="band" id="faq">
    <div class="wrap faq-grid">
      <div>
        <div class="head"><div class="stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div><h2 data-i="faq.title"></h2><p data-i="faq.sub"></p></div>
        <div class="ph"><img src="{{ 'kiddoo-faq-equipe.jpg' | file_img_url: '1000x' }}" alt="" loading="lazy"></div>
      </div>
      <div class="faqs" id="faqs"></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="final">
        <img src="{{ 'kiddoo-cta-cour.jpg' | file_img_url: '1800x' }}" alt="" loading="lazy">
        <div class="stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <h2 data-i="final.title"></h2>
        <p data-i="final.sub"></p>
        <div class="cta"><a class="btn btn-primary" href="#commande" data-i="final.btn"></a><a class="btn btn-ghost" id="final-wa" target="_blank" rel="noopener" data-i="final.wa"></a></div>
      </div>
    </div>
  </section>
</main>

<footer><a class="logo" href="#top" aria-label="Kiddoo"><img src="{{ 'kiddoo-logo.png' | file_img_url: '300x' }}" alt="Kiddoo" width="108" height="24"></a><span data-i="foot"></span></footer>

