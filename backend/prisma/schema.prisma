// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SchoolType {
  kindergarten
  primary
  secondary
}

enum UserRole {
  super_admin
  admin
  /// إداري: office staff (registration, attendance, communication, inventory,
  /// collecting payments) without the director's management rights.
  administrative
  teacher
  parent
  student
  /// An employee who does not use the app (cleaning, kitchen, driver…): in
  /// the staff list and the payroll, but cannot sign in.
  staff
}

enum Language {
  ar
  fr
}

enum Gender {
  male
  female
}

enum BloodType {
  a_positive
  a_negative
  b_positive
  b_negative
  ab_positive
  ab_negative
  o_positive
  o_negative
}

enum LearnerType {
  child
  student
}

enum ContractType {
  full_time
  part_time
  contract
}

enum AttendanceStatus {
  present
  absent
  late
}

enum Mood {
  happy
  sad
  tired
  excited
  calm
}

enum MessageType {
  text
  photo
  document
}

enum ConsentStatus {
  pending
  approved
  declined
}

// ─── Payment Management Enums ────────────────────────────────────────────────

enum BillingCycleType {
  monthly
  custom
}

enum NotificationSettingType {
  enabled
  disabled
}

enum EnrollmentStatus {
  active
  withdrawn
  completed
}

enum PaymentChannel {
  cash
  ccp
  baridimob
}

enum DiscountType {
  scholarship
  sibling
  staff
  custom
}

enum MedicalNoteType {
  allergy
  condition
  medication
}

enum Severity {
  low
  medium
  high
}

enum NotificationType {
  absence_alert
  payment_received
  payment_overdue
  invoice_sent
  daily_report
  message_new
  announcement
  event_consent
  substitution
}

// ─── Models ──────────────────────────────────────────────────────────────────

model School {
  id           String     @id @default(uuid())
  name         String
  schoolType   SchoolType @map("school_type")
  address      String
  wilaya       String
  logoPublicId String?    @map("logo_public_id")
  contactEmail String     @map("contact_email")
  contactPhone String     @map("contact_phone")
  isActive     Boolean    @default(true) @map("is_active")
  /// Cash left in the desks is flagged from this amount (DZD)…
  cashAlertAmount Decimal @default(50000) @map("cash_alert_amount") @db.Decimal(10, 2)
  /// …or when the oldest cash in a desk is this many days old.
  cashAlertDays   Int     @default(3) @map("cash_alert_days")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  users          User[]
  academicYears  AcademicYear[]
  classrooms     Classroom[]
  rooms          Room[]
  stockItems     StockItem[]
  equipment      Equipment[]
  substitutions  Substitution[]
  accessProfiles AccessProfile[]
  accessLogs       AccessLog[]
  cashHandovers    CashHandover[]
  documents        SchoolDocument[]
  staffShifts      StaffShift[]
  staffAbsences    StaffAbsence[]
  accessExceptions AccessException[]
  stockMovements StockMovement[]
  children       Child[]
  expenses       Expense[]
  subscription   SchoolSubscription?
  branches       Branch[]

  @@index([deletedAt])
  @@map("schools")
}

model User {
  id                 String    @id @default(uuid())
  schoolId           String?   @map("school_id")
  branchId           String?   @map("branch_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  // Not @unique here: uniqueness is enforced only among non-deleted rows,
  // scoped per school, via a partial index (see migrations 0011 and 0012) —
  // the same email can belong to separate accounts in different schools,
  // and a soft-deleted user's email can be reused by a new/invited user.
  email              String?
  passwordHash       String    @map("password_hash")
  role               UserRole
  /// Office staff (administrative): what they may do. The director needs none.
  accessProfileId String?  @map("access_profile_id")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  fcmToken           String?   @map("fcm_token")
  phone              String?   @map("phone")
  /// Their own photo (Cloudinary, private), set from "Mon profil".
  avatarPublicId     String?   @map("avatar_public_id")
  address            String?
  nationalId         String?   @map("national_id")
  preferredLanguage  Language  @default(fr) @map("preferred_language")
  // When the user last used the app (login or session renewal, at most daily).
  lastActiveAt       DateTime? @map("last_active_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  school                      School?              @relation(fields: [schoolId], references: [id])
  branch                      Branch?              @relation(fields: [branchId], references: [id])
  staffProfile                StaffProfile?
  staffShifts                 StaffShift[]         @relation("StaffShifts")
  staffAbsences               StaffAbsence[]       @relation("StaffAbsences")
  parentLinks                 ParentChildLink[]
  notifications               Notification[]
  sentMessages                Message[]
  teacherConversations        Conversation[]       @relation("TeacherConversations")
  parentConversations         Conversation[]       @relation("ParentConversations")
  initiatedStaffConversations StaffConversation[]  @relation("StaffConvInitiator")
  receivedStaffConversations  StaffConversation[]  @relation("StaffConvRecipient")
  sentStaffMessages           StaffMessage[]
  classrooms                  Classroom[]
  attendanceMarks             AttendanceRecord[]
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  employeeSalary              EmployeeSalary?
  salaryPayments              SalaryPayment[]
  paymentRecords              PaymentRecord[]      @relation("PaymentRecorder")
  discountsCreated            Discount[]
  stockMovements              StockMovement[]
  substitutionsAbsent         Substitution[]       @relation("SubstitutionAbsent")
  substitutionsTaken          Substitution[]       @relation("SubstitutionSubstitute")
  substitutionsCreated        Substitution[]       @relation("SubstitutionCreatedBy")
  accessProfile               AccessProfile?       @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  accessExceptions            AccessException[]    @relation("AccessExceptionUser")
  cashHandoversGiven          CashHandover[]       @relation("CashHandoverCashier")
  cashHandoversTaken          CashHandover[]       @relation("CashHandoverCollector")

  @@index([deletedAt])
  @@index([email])
  @@index([email, schoolId])
  @@map("users")
}

model StaffProfile {
  id               String       @id @default(uuid())
  userId           String       @unique @map("user_id")
  schoolId         String       @map("school_id")
  position         String
  contractType     ContractType @map("contract_type")
  contractStart    DateTime     @map("contract_start") @db.Date
  contractEnd      DateTime?    @map("contract_end") @db.Date
  documentPublicId String?      @map("document_public_id")
  documentFormat   String?      @map("document_format")
  createdAt        DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("staff_profiles")
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  school          School           @relation(fields: [schoolId], references: [id])
  classrooms      Classroom[]
  children        Child[]
  branchCalendars BranchCalendar[]
  enrollments     Enrollment[]
  paymentRecords  PaymentRecord[]
  expenses        Expense[]
  salaryPayments  SalaryPayment[]
  stockMovements  StockMovement[]

  @@map("academic_years")
}

model Classroom {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  academicYearId String    @map("academic_year_id")
  teacherUserId  String?   @map("teacher_user_id")
  name           String
  capacity       Int
  roomId         String?   @map("room_id")
  level          String?
  /// Its color wherever the class appears (a name of the palette); null: one is picked from its id.
  color          String?
  workingDays    Json      @default("[\"sunday\",\"monday\",\"tuesday\",\"wednesday\",\"thursday\"]") @map("working_days")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  school            School                @relation(fields: [schoolId], references: [id])
  academicYear      AcademicYear          @relation(fields: [academicYearId], references: [id])
  teacher           User?                 @relation(fields: [teacherUserId], references: [id])
  room              Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments       ClassroomEnrollment[]
  attendanceRecords AttendanceRecord[]
  eventLinks        EventClassroom[]
  // Fees explicitly linked to this classroom (see BranchFeeClassroom).
  feeAssignments    BranchFeeClassroom[]
  substitutions     Substitution[]

  @@index([deletedAt])
  @@index([roomId])
  @@map("classrooms")
}

/// A physical room of the school. Unlike classes, rooms outlast the school
/// year: each year's classes are placed in them.
model Room {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  /// Most children the room can hold; unknown for rooms carried over from the old free-text field.
  capacity  Int?
  location  String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  classrooms Classroom[]
  equipment  Equipment[]

  @@index([schoolId])
  @@map("rooms")
}

model ClassroomEnrollment {
  id          String   @id @default(uuid())
  childId     String   @map("child_id")
  classroomId String   @map("classroom_id")
  enrolledAt  DateTime @default(now()) @map("enrolled_at")

  child     Child     @relation(fields: [childId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([childId, classroomId])
  @@map("classroom_enrollments")
}

model Child {
  id             String      @id @default(uuid())
  schoolId       String      @map("school_id")
  academicYearId String      @map("academic_year_id")
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  dateOfBirth    DateTime    @map("date_of_birth") @db.Date
  gender         Gender
  photoPublicId  String?     @map("photo_public_id")
  enrollmentDate DateTime    @map("enrollment_date") @db.Date
  learnerType    LearnerType @default(child) @map("learner_type")
  nationalId     String?     @map("national_id")
  address        String?
  placeOfBirth   String?     @map("place_of_birth")
  bloodType      BloodType?  @map("blood_type")
  isActive       Boolean     @default(true) @map("is_active")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  school             School                @relation(fields: [schoolId], references: [id])
  academicYear       AcademicYear          @relation(fields: [academicYearId], references: [id])
  enrollments        ClassroomEnrollment[]
  parentLinks        ParentChildLink[]
  emergencyContacts  EmergencyContact[]
  medicalNotes       MedicalNote[]
  attendanceRecords  AttendanceRecord[]
  dailyReports       DailyReport[]
  consentForms       ConsentForm[]
  paymentEnrollments Enrollment[]
  paymentRecords     PaymentRecord[]

  @@index([schoolId, academicYearId, isActive])
  @@index([deletedAt])
  @@map("children")
}

model ParentChildLink {
  id           String   @id @default(uuid())
  childId      String   @map("child_id")
  parentUserId String   @map("parent_user_id")
  relationship String
  isPrimary    Boolean  @default(false) @map("is_primary")
  canPickup    Boolean  @default(true) @map("can_pickup")
  createdAt    DateTime @default(now()) @map("created_at")

  child  Child @relation(fields: [childId], references: [id])
  parent User  @relation(fields: [parentUserId], references: [id])

  @@unique([childId, parentUserId])
  @@map("parent_child_links")
}

model EmergencyContact {
  id                 String   @id @default(uuid())
  childId            String   @map("child_id")
  name               String
  relationship       String
  phone              String
  address            String?
  nationalId         String?  @map("national_id")
  isAuthorizedPickup Boolean  @default(false) @map("is_authorized_pickup")
  createdAt          DateTime @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@map("emergency_contacts")
}

model MedicalNote {
  id        String          @id @default(uuid())
  childId   String          @map("child_id")
  type      MedicalNoteType
  title     String
  details   String?
  severity  Severity        @default(low)
  createdAt DateTime        @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@map("medical_notes")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  childId        String           @map("child_id")
  classroomId    String           @map("classroom_id")
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String           @map("marked_by_user_id")
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")

  child     Child     @relation(fields: [childId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  markedBy  User      @relation(fields: [markedByUserId], references: [id])

  @@unique([childId, date])
  @@index([classroomId, date])
  @@index([schoolId, date])
  @@map("attendance_records")
}

model DailyReport {
  id                 String   @id @default(uuid())
  schoolId           String   @map("school_id")
  childId            String   @map("child_id")
  date               DateTime @db.Date
  mood               Mood
  mealsEaten         Int      @map("meals_eaten")
  napDurationMinutes Int?     @map("nap_duration_minutes")
  activities         String?
  generalNote        String?  @map("general_note")
  createdByUserId    String   @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  child  Child              @relation(fields: [childId], references: [id])
  photos DailyReportPhoto[]

  @@unique([childId, date])
  @@map("daily_reports")
}

model DailyReportPhoto {
  id                 String   @id @default(uuid())
  dailyReportId      String   @map("daily_report_id")
  cloudinaryPublicId String   @map("cloudinary_public_id")
  /// The device's id for the photo, so a resend doesn't add it twice.
  clientId           String?  @unique @map("client_id")
  createdAt          DateTime @default(now()) @map("created_at")

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id])

  @@map("daily_report_photos")
}

model Conversation {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  childId       String   @map("child_id")
  teacherUserId String   @map("teacher_user_id")
  parentUserId  String   @map("parent_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @map("last_message_at")
  // A parent ↔ school office thread: teacherUserId then holds an office
  // member, and every office member can read and answer it.
  withOffice    Boolean  @default(false) @map("with_office")

  teacher  User      @relation("TeacherConversations", fields: [teacherUserId], references: [id])
  parent   User      @relation("ParentConversations", fields: [parentUserId], references: [id])
  messages Message[]

  @@map("conversations")
}

model Message {
  id                 String      @id @default(uuid())
  conversationId     String      @map("conversation_id")
  senderUserId       String      @map("sender_user_id")
  content            String?
  messageType        MessageType @map("message_type")
  cloudinaryPublicId String?     @map("cloudinary_public_id")
  isRead             Boolean     @default(false) @map("is_read")
  /// The sending device's id, so a message sent again is only saved once.
  clientId           String?     @unique @map("client_id")
  createdAt          DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Announcement {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  classroomId     String?   @map("classroom_id")
  title           String
  content         String
  createdByUserId String    @map("created_by_user_id")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("announcements")
}

model Event {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  title           String
  description     String?
  startDatetime   DateTime  @map("start_datetime")
  endDatetime     DateTime? @map("end_datetime")
  location        String?
  requiresConsent Boolean   @default(false) @map("requires_consent")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  consentForms ConsentForm[]
  classrooms   EventClassroom[]

  @@map("events")
}

/**
 * Links an event to one of the (possibly several) classrooms it's scoped to.
 * No rows for an event means it applies to the whole school.
 */
model EventClassroom {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  classroomId String   @map("classroom_id")
  createdAt   DateTime @default(now()) @map("created_at")

  event     Event     @relation(fields: [eventId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@unique([eventId, classroomId])
  @@map("event_classrooms")
}

model ConsentForm {
  id          String        @id @default(uuid())
  eventId     String        @map("event_id")
  childId     String        @map("child_id")
  status      ConsentStatus @default(pending)
  respondedAt DateTime?     @map("responded_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  child Child @relation(fields: [childId], references: [id])

  @@unique([eventId, childId])
  @@map("consent_forms")
}

model Expense {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  category        String
  description     String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("DZD")
  date            DateTime @db.Date
  /// The school year the expense counts in (chosen when it is recorded).
  academicYearId  String?  @map("academic_year_id")
  receiptPublicId String?  @map("receipt_public_id")
  createdByUserId String   @map("created_by_user_id")
  /// Paid with money from this person's cash desk (deducted from it).
  paidFromCashUserId String? @map("paid_from_cash_user_id")
  /// The handover it was counted in; null while not yet handed over.
  cashHandoverId  String?  @map("cash_handover_id")
  /// Id made by the form that recorded it: the same expense sent twice is saved once.
  clientId        String?  @unique @map("client_id")
  createdAt       DateTime @default(now()) @map("created_at")

  school        School         @relation(fields: [schoolId], references: [id])
  cashHandover  CashHandover?  @relation(fields: [cashHandoverId], references: [id])
  academicYear  AcademicYear?  @relation(fields: [academicYearId], references: [id])
  /// The purchase of supplies it was recorded with, if any.
  stockMovement StockMovement?

  @@index([schoolId, academicYearId])
  @@index([paidFromCashUserId, cashHandoverId])
  @@map("expenses")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          NotificationType
  title         String
  body          String
  referenceId   String?          @map("reference_id")
  referenceType String?          @map("reference_type")
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── SaaS Billing ────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  trial
  active
  overdue
  cancelled
  suspended
}

enum BillingCycle {
  monthly
  annual
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceAnnual  Decimal? @map("price_annual") @db.Decimal(10, 2)
  currency     String   @default("DZD")
  maxChildren  Int?     @map("max_children")
  maxUsers     Int?     @map("max_users")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions SchoolSubscription[]

  @@map("subscription_plans")
}

model SchoolSubscription {
  id                 String             @id @default(uuid())
  schoolId           String             @unique @map("school_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(trial)
  billingCycle       BillingCycle       @default(monthly) @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Date
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Date
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  school   School                @relation(fields: [schoolId], references: [id])
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@map("school_subscriptions")
}

model SubscriptionPayment {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("DZD")
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  paidAt         DateTime  @map("paid_at")
  recordedBy     String    @map("recorded_by")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  subscription SchoolSubscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_payments")
}

// ─── Payroll ─────────────────────────────────────────────────────────────────

model EmployeeSalary {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  schoolId        String   @map("school_id")
  salaryType      String   @default("fixed") @map("salary_type")
  baseSalary      Decimal? @map("base_salary") @db.Decimal(10, 2)
  ratePerStudent  Decimal? @map("rate_per_student") @db.Decimal(10, 2)
  /// per_student only: "working_day" (students × working days) or "present_day" (attendance).
  perStudentBasis String   @default("working_day") @map("per_student_basis")
  currency        String   @default("DZD")
  effectiveFrom   DateTime @map("effective_from") @db.Date
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@map("employee_salaries")
}

model SalaryPayment {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  schoolId       String    @map("school_id")
  month          Int
  year           Int
  baseSalary     Decimal   @map("base_salary") @db.Decimal(10, 2)
  bonuses        Decimal   @default(0) @db.Decimal(10, 2)
  deductions     Decimal   @default(0) @db.Decimal(10, 2)
  netSalary      Decimal   @map("net_salary") @db.Decimal(10, 2)
  studentCount   Int?      @map("student_count")
  /// Student-days a per-student salary was computed on.
  studentDays    Int?      @map("student_days")
  paidAt         DateTime  @map("paid_at") @db.Date
  note           String?
  /// The school year the paid month falls in.
  academicYearId String?   @map("academic_year_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([userId, month, year])
  @@index([schoolId, year, month])
  @@index([schoolId, academicYearId])
  @@index([deletedAt])
  @@map("salary_payments")
}

model InvitationToken {
  id        String    @id @default(uuid())
  email     String
  schoolId  String    @map("school_id")
  role      UserRole
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invitation_tokens")
}

// ─── Payment Management ──────────────────────────────────────────────────────

model Branch {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  name      String
  address   String?
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school         School               @relation(fields: [schoolId], references: [id])
  billingConfig  BranchBillingConfig?
  calendars      BranchCalendar[]
  enrollments    Enrollment[]
  paymentRecords PaymentRecord[]
  users          User[]
  fees           BranchFee[]

  @@index([schoolId])
  @@index([deletedAt])
  @@map("branches")
}

model BranchFee {
  id              String            @id @default(uuid())
  branchId        String            @map("branch_id")
  name            String
  amount          Decimal           @db.Decimal(10, 2)
  isActive        Boolean           @default(true) @map("is_active")
  // Cyclic billing is an option a fee can carry: null billingCycle means a
  // one-shot ad-hoc fee (charged once, immediately, when applied); a set
  // billingCycle makes it recurring, generating a full cycle of billing
  // periods (like an enrollment's base fee) when applied. billingDueDay and
  // gracePeriodDays are required together with billingCycle.
  billingCycle    BillingCycleType? @map("billing_cycle")
  billingDueDay   Int?              @map("billing_due_day")
  gracePeriodDays Int?              @map("grace_period_days")
  // Whole-school scope: set when the fee is assigned to the whole school; every
  // new enrollment in the school then gets this fee applied automatically.
  appliesToSchool Boolean           @default(false) @map("applies_to_school")
  // Whether the fee is offered in the child-registration wizard's fee step.
  showInWizard    Boolean           @default(true) @map("show_in_wizard")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  branch               Branch               @relation(fields: [branchId], references: [id])
  billingPeriods       BillingPeriod[]
  baseForEnrollments   Enrollment[]         @relation("EnrollmentBaseFee")
  periodAssignments    BranchFeePeriod[]
  classroomAssignments BranchFeeClassroom[]
  discounts            Discount[]

  @@index([branchId])
  @@map("branch_fees")
}

model BranchBillingConfig {
  id                  String                  @id @default(uuid())
  branchId            String                  @unique @map("branch_id")
  notificationSetting NotificationSettingType @default(disabled) @map("notification_setting")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("branch_billing_configs")
}

model BranchCalendar {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  academicYearId String   @map("academic_year_id")
  label          String
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch         Branch            @relation(fields: [branchId], references: [id])
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  // A period is a reusable building block — assignable to zero, one, or
  // several fees (see BranchFeePeriod).
  feeAssignments BranchFeePeriod[]

  @@index([branchId, academicYearId])
  @@map("branch_calendars")
}

/**
 * Many-to-many assignment of a BranchCalendar period to a BranchFee: a
 * period can be reused across several fees, and a fee can be assigned
 * several periods (e.g. its own subset of the branch's trimesters).
 */
model BranchFeePeriod {
  id               String   @id @default(uuid())
  branchFeeId      String   @map("branch_fee_id")
  branchCalendarId String   @map("branch_calendar_id")
  createdAt        DateTime @default(now()) @map("created_at")

  branchFee      BranchFee      @relation(fields: [branchFeeId], references: [id], onDelete: Cascade)
  branchCalendar BranchCalendar @relation(fields: [branchCalendarId], references: [id], onDelete: Cascade)

  @@unique([branchFeeId, branchCalendarId])
  @@index([branchCalendarId])
  @@map("branch_fee_periods")
}

/**
 * Many-to-many link between a BranchFee and a Classroom: lets a fee declare
 * which classrooms it applies to (e.g. a class-specific uniform fee), purely
 * as metadata — it does not itself apply the fee to anyone. A fee with no
 * classroom links is a general fee that applies everywhere.
 */
model BranchFeeClassroom {
  id          String   @id @default(uuid())
  branchFeeId String   @map("branch_fee_id")
  classroomId String   @map("classroom_id")
  createdAt   DateTime @default(now()) @map("created_at")

  branchFee BranchFee @relation(fields: [branchFeeId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([branchFeeId, classroomId])
  @@index([classroomId])
  @@map("branch_fee_classrooms")
}

model Enrollment {
  id              String           @id @default(uuid())
  childId         String           @map("child_id")
  branchId        String           @map("branch_id")
  academicYearId  String           @map("academic_year_id")
  // The recurring BranchFee this enrollment's base billing periods were
  // generated from (cycle/due-day/grace-period come from that fee). Nullable
  // for enrollments created before fees carried a billing cycle.
  baseFeeId       String?          @map("base_fee_id")
  startDate       DateTime         @map("start_date") @db.Date
  status          EnrollmentStatus @default(active)
  registrationFee Decimal?         @map("registration_fee") @db.Decimal(10, 2)
  recurringFee    Decimal          @map("recurring_fee") @db.Decimal(10, 2)
  withdrawalDate  DateTime?        @map("withdrawal_date") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  child          Child           @relation(fields: [childId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  baseFee        BranchFee?      @relation("EnrollmentBaseFee", fields: [baseFeeId], references: [id])
  billingPeriods BillingPeriod[]
  discounts      Discount[]

  @@unique([childId, academicYearId])
  @@index([branchId, academicYearId])
  @@index([childId])
  @@index([baseFeeId])
  @@map("enrollments")
}

model Discount {
  id              String       @id @default(uuid())
  enrollmentId    String       @map("enrollment_id")
  type            DiscountType
  /// Either a percentage or a fixed amount (per échéance), never both.
  percentage      Decimal?     @db.Decimal(5, 2)
  fixedAmount     Decimal?     @map("fixed_amount") @db.Decimal(10, 2)
  description     String?
  validFrom       DateTime     @map("valid_from") @db.Date
  validTo         DateTime?    @map("valid_to") @db.Date
  /// The fee this discount applies to; null = every recurring fee.
  branchFeeId     String?      @map("branch_fee_id")
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  createdBy  User       @relation(fields: [createdByUserId], references: [id])
  branchFee  BranchFee? @relation(fields: [branchFeeId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([branchFeeId])
  @@map("discounts")
}

model BillingPeriod {
  id                   String    @id @default(uuid())
  enrollmentId         String    @map("enrollment_id")
  periodStart          DateTime  @map("period_start") @db.Date
  periodEnd            DateTime  @map("period_end") @db.Date
  dueDate              DateTime  @map("due_date") @db.Date
  graceEndDate         DateTime  @map("grace_end_date") @db.Date
  amountDue            Decimal   @map("amount_due") @db.Decimal(10, 2)
  /// Amount before any discount; discounts are always recomputed from it.
  baseAmount           Decimal?  @map("base_amount") @db.Decimal(10, 2)
  isRegistrationPeriod Boolean   @default(false) @map("is_registration_period")
  branchFeeId          String?   @map("branch_fee_id")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  enrollment         Enrollment          @relation(fields: [enrollmentId], references: [id])
  branchFee          BranchFee?          @relation(fields: [branchFeeId], references: [id])
  paymentAllocations PaymentAllocation[]

  @@index([enrollmentId])
  @@index([dueDate])
  @@index([cancelledAt])
  @@index([branchFeeId])
  @@map("billing_periods")
}

model PaymentRecord {
  id                String         @id @default(uuid())
  branchId          String         @map("branch_id")
  childId           String         @map("child_id")
  receiptNumber     String         @unique @map("receipt_number")
  totalAmount       Decimal        @map("total_amount") @db.Decimal(10, 2)
  channel           PaymentChannel
  valueDate         DateTime       @map("value_date") @db.Date
  recordedBy        String         @map("recorded_by")
  referenceNote     String?        @map("reference_note")
  isCorrection      Boolean        @default(false) @map("is_correction")
  correctsPaymentId String?        @map("corrects_payment_id")
  /// Set by the device that recorded it (payments entered offline): sending it again saves it once.
  clientId          String?        @unique @map("client_id")
  /// The school year of the échéances it pays (a payment pays one year only).
  academicYearId    String?        @map("academic_year_id")
  /// Cash only: whose cash desk the money is in (who took it; for a refund,
  /// whose desk it leaves). Null for other channels and for payments from
  /// before cash desks existed.
  cashierUserId     String?        @map("cashier_user_id")
  /// The handover it was counted in; null while still in the cash desk.
  cashHandoverId    String?        @map("cash_handover_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  branch           Branch              @relation(fields: [branchId], references: [id])
  cashHandover     CashHandover?       @relation(fields: [cashHandoverId], references: [id])
  child            Child               @relation(fields: [childId], references: [id])
  recorder         User                @relation("PaymentRecorder", fields: [recordedBy], references: [id])
  correctedPayment PaymentRecord?      @relation("PaymentCorrections", fields: [correctsPaymentId], references: [id])
  corrections      PaymentRecord[]     @relation("PaymentCorrections")
  allocations      PaymentAllocation[]
  academicYear     AcademicYear?       @relation(fields: [academicYearId], references: [id])

  @@index([branchId, valueDate])
  @@index([branchId, academicYearId])
  @@index([childId])
  @@index([correctsPaymentId])
  @@index([cashierUserId, cashHandoverId])
  @@map("payment_records")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentRecordId String   @map("payment_record_id")
  billingPeriodId String   @map("billing_period_id")
  amount          Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  paymentRecord PaymentRecord @relation(fields: [paymentRecordId], references: [id])
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id])

  @@unique([paymentRecordId, billingPeriodId])
  @@index([billingPeriodId])
  @@map("payment_allocations")
}

model PaymentAuditEntry {
  id              String   @id @default(uuid())
  branchId        String   @map("branch_id")
  paymentRecordId String   @map("payment_record_id")
  action          String
  performedBy     String   @map("performed_by")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([branchId, createdAt])
  @@index([paymentRecordId])
  @@map("payment_audit_entries")
}

// ─── Staff Messaging ─────────────────────────────────────────────────────────

/// Direct conversation between two staff members (teacher↔teacher or admin↔teacher).
/// School-scoped. A canonical pair is stored with the lower UUID as initiatorId to
/// avoid duplicates; the service enforces this ordering when creating conversations.
model StaffConversation {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  initiatorId   String   @map("initiator_id")
  recipientId   String   @map("recipient_id")
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  initiator User           @relation("StaffConvInitiator", fields: [initiatorId], references: [id])
  recipient User           @relation("StaffConvRecipient", fields: [recipientId], references: [id])
  messages  StaffMessage[]

  @@unique([schoolId, initiatorId, recipientId])
  @@index([initiatorId])
  @@index([recipientId])
  @@map("staff_conversations")
}

model StaffMessage {
  id                 String      @id @default(uuid())
  conversationId     String      @map("conversation_id")
  senderUserId       String      @map("sender_user_id")
  content            String?
  messageType        MessageType @default(text) @map("message_type")
  cloudinaryPublicId String?     @map("cloudinary_public_id")
  isRead             Boolean     @default(false) @map("is_read")
  /// The sending device's id, so a message sent again is only saved once.
  clientId           String?     @unique @map("client_id")
  createdAt          DateTime    @default(now()) @map("created_at")

  conversation StaffConversation @relation(fields: [conversationId], references: [id])
  sender       User              @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@map("staff_messages")
}

enum StockMovementType {
  purchase
  use
  adjustment
}

/// A supply the school keeps in stock (diapers, soap, paper…): what is left,
/// and below what it should be bought again.
model StockItem {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  name           String
  /// hygiene, cleaning, stationery, crafts, food, other
  category       String
  /// How it is counted: pack, bottle, box, piece…
  unit           String
  quantity       Decimal  @default(0) @db.Decimal(10, 2)
  alertThreshold Decimal  @default(0) @map("alert_threshold") @db.Decimal(10, 2)
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school    School          @relation(fields: [schoolId], references: [id])
  movements StockMovement[]

  @@index([schoolId])
  @@map("stock_items")
}

/// A change of a supply's stock: bought (+), used (-) or counted again (±).
model StockMovement {
  id              String            @id @default(uuid())
  schoolId        String            @map("school_id")
  itemId          String            @map("item_id")
  type            StockMovementType
  /// Signed change of the stock.
  quantity        Decimal           @db.Decimal(10, 2)
  /// The stock right after it.
  stockAfter      Decimal           @map("stock_after") @db.Decimal(10, 2)
  date            DateTime          @db.Date
  /// The school year its date counts in.
  academicYearId  String?           @map("academic_year_id")
  note            String?
  /// The expense a purchase was recorded with.
  expenseId       String?           @unique @map("expense_id")
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  school       School        @relation(fields: [schoolId], references: [id])
  item         StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdByUserId], references: [id])

  @@index([itemId, date])
  @@index([schoolId, academicYearId])
  @@map("stock_movements")
}

enum EquipmentCondition {
  good
  repair
  broken
}

/// Something the school owns and keeps (beds, tables, toys, computers,
/// extinguishers…), counted where it is: in a room, or in no room (storage).
model Equipment {
  id           String             @id @default(uuid())
  schoolId     String             @map("school_id")
  name         String
  /// furniture, toys, electronics, safety, kitchen, outdoor, other
  category     String
  quantity     Int                @default(1)
  condition    EquipmentCondition @default(good)
  roomId       String?            @map("room_id")
  purchaseDate DateTime?          @map("purchase_date") @db.Date
  /// Value of one, in DZD.
  unitValue    Decimal?           @map("unit_value") @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([roomId])
  @@map("equipment")
}

/// A teacher away from their class for one day or a planned period, and who
/// takes the class meanwhile (or nobody). The substitute works with the class
/// — attendance, daily reports, children — on those days only.
model Substitution {
  id               String    @id @default(uuid())
  schoolId         String    @map("school_id")
  classroomId      String    @map("classroom_id")
  /// The class's teacher when it was recorded.
  absentTeacherId  String?   @map("absent_teacher_id")
  /// null: nobody takes the class (it has no teacher those days).
  substituteUserId String?   @map("substitute_user_id")
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime  @map("end_date") @db.Date
  /// illness, leave, training, other
  reason           String
  note             String?
  parentsNotified  Boolean   @default(false) @map("parents_notified")
  cancelledAt      DateTime? @map("cancelled_at")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  school        School    @relation(fields: [schoolId], references: [id])
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  absentTeacher User?     @relation("SubstitutionAbsent", fields: [absentTeacherId], references: [id])
  substitute    User?     @relation("SubstitutionSubstitute", fields: [substituteUserId], references: [id])
  createdBy     User      @relation("SubstitutionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([classroomId, startDate])
  @@index([substituteUserId, startDate])
  @@index([schoolId, startDate])
  @@map("substitutions")
}

/// What an office staff member may do, area by area (none / view / edit),
/// plus deleting and correcting payments. Made by the director; the default
/// one ("Agent administratif") is created with the school.
model AccessProfile {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  description String?
  /// { areas: { children: "edit", … }, delete: bool, correctPayments: bool }
  permissions Json
  /// The school's default profile, given to new office staff.
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])
  users  User[]

  @@unique([schoolId, name])
  @@map("access_profiles")
}

/// What changed in the rights, by whom and when: profiles made, changed or
/// deleted, profiles given, exceptions added or removed. Never edited.
model AccessLog {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  /// Who made the change (the director); names kept as they were.
  actorUserId  String   @map("actor_user_id")
  actorName    String   @map("actor_name")
  /// profile_created, profile_updated, profile_deleted, profile_default,
  /// profile_assigned, exception_added, exception_removed
  action       String
  profileId    String?  @map("profile_id")
  profileName  String?  @map("profile_name")
  targetUserId String?  @map("target_user_id")
  targetName   String?  @map("target_name")
  /// The change itself: { changes: [{ key, from, to }] }, { from, to }, an exception…
  details      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([targetUserId])
  @@map("access_logs")
}

/// One person's right differing from their profile's, in one area (or the
/// delete / correct-payments rights), until a date or for good.
model AccessException {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  userId          String    @map("user_id")
  /// An area (children, payroll…) or "delete" / "correctPayments".
  area            String
  /// none / view / edit; for the two rights: none (off) or edit (on).
  level           String
  /// Last day it applies; null: until removed.
  endsOn          DateTime? @map("ends_on") @db.Date
  note            String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation("AccessExceptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
  @@index([schoolId])
  @@map("access_exceptions")
}

/// A cash desk handed over: the money one person took (cash payments, less
/// refunds and cash expenses, plus the float they started with), counted by
/// who collects it. Never edited: it settles who held what.
model CashHandover {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  /// Whose cash desk.
  cashierUserId     String   @map("cashier_user_id")
  /// Who counted and took the money.
  collectedByUserId String   @map("collected_by_user_id")
  /// handover (to someone else) or deposit (a director's own desk, to the bank or safe).
  kind              String   @default("handover")
  /// The float left at the previous handover.
  openingFloat      Decimal  @map("opening_float") @db.Decimal(10, 2)
  /// Cash payments less cash refunds since then.
  cashIn            Decimal  @map("cash_in") @db.Decimal(10, 2)
  /// Expenses paid from the desk since then.
  cashOut           Decimal  @map("cash_out") @db.Decimal(10, 2)
  /// openingFloat + cashIn - cashOut.
  expectedAmount    Decimal  @map("expected_amount") @db.Decimal(10, 2)
  /// What was found in the desk.
  countedAmount     Decimal  @map("counted_amount") @db.Decimal(10, 2)
  /// Left in the desk to give change; the rest is taken.
  floatLeft         Decimal  @default(0) @map("float_left") @db.Decimal(10, 2)
  /// countedAmount - expectedAmount: negative when money is missing.
  difference        Decimal  @db.Decimal(10, 2)
  /// Why there is a difference (required when there is one).
  reason            String?
  note              String?
  /// Id made by the form that recorded it: the same handover sent twice is saved once.
  clientId          String?  @unique @map("client_id")
  createdAt         DateTime @default(now()) @map("created_at")

  school      School          @relation(fields: [schoolId], references: [id])
  cashier     User            @relation("CashHandoverCashier", fields: [cashierUserId], references: [id])
  collectedBy User            @relation("CashHandoverCollector", fields: [collectedByUserId], references: [id])
  payments    PaymentRecord[]
  expenses    Expense[]

  @@index([schoolId, createdAt])
  @@index([cashierUserId, createdAt])
  @@map("cash_handovers")
}

/// A document the school prints or sends often (enrollment form, rules,
/// health sheet…): one file, kept in the school's library.
model SchoolDocument {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  name             String
  /// enrollment, health, rules, other
  category         String
  note             String?
  filePublicId     String   @map("file_public_id")
  fileExtension    String   @map("file_extension")
  /// In bytes.
  fileSize         Int      @map("file_size")
  /// Shown to the families in their space.
  visibleToParents Boolean  @default(false) @map("visible_to_parents")
  createdByUserId  String?  @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, category])
  @@map("school_documents")
}

/// One shift of a staff member's usual week: the same every week ("all"), or
/// of the weeks A or B when their week alternates (morning / afternoon).
model StaffShift {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  userId    String   @map("user_id")
  /// 0: Sunday … 6: Saturday
  weekday   Int
  /// all, a, b
  week      String   @default("all")
  /// HH:MM
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation("StaffShifts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("staff_shifts")
}

/// Days a staff member is away (whole days), whatever their job. A teacher's
/// replacement says the same for its own days, without a row here.
model StaffAbsence {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  userId          String   @map("user_id")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  /// illness, leave, unpaid, training, other
  reason          String
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation("StaffAbsences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@index([userId, startDate])
  @@map("staff_absences")
}
